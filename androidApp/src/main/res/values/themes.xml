<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws the entire UI, so this theme only needs to cover the pre-Compose window:
      no action bar, and a transparent system bar background for edge-to-edge.
    -->
    <style name="Theme.OrbitAI" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
