<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws the entire UI. windowBackground is a solid themed fill only — the mark is drawn
      once in OrbitSplashScreen so the logo does not flash twice on cold start.
    -->
    <style name="Theme.OrbitAI" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/orbit_splash_background</item>
        <!-- Follow system icon contrast; app theme does not flip this. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
